{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.8/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": [
            // DI PHP configs are wiring, not behavioural units under mutation.
            "Resources"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log",
        "github": true
    },
    // Each ignore must name the equivalent-mutant reason. Prefer a stronger test over a new ignore.
    // Never lower minMsi to silence escapes.
    "mutators": {
        "@default": true,
        "MethodCallRemoval": {
            "ignoreSourceCodeByRegex": [
                // Equivalent in unit tests: registerShutdown only installs a process-level callback;
                // request delivery is asserted via stop()+flush() on the HTTP adapter.
                "\\$profiler->registerShutdown\\(\\);",
                // Equivalent: Symfony Bundle::build() is empty; only our compiler pass matters.
                "parent::build\\(\\$container\\);",
            ]
        },
        "CastString": {
            "ignore": [
                // Equivalent: SymfonyStyle table stringifies ints the same as an explicit (string) cast.
                "Tracewick\\Bridge\\Symfony\\Command\\StatsCommand::execute",
            ]
        },

        "IncrementInteger": {
            "ignore": [
                // Equivalent: InvalidConfigurationException code is unused by callers/tests.
                "Tracewick\\Bridge\\Symfony\\DependencyInjection\\TracewickExtension::load",
                // Equivalent: isset($controller[0], $controller[1]) index swaps still fail later
                // type checks or yield a null controller label.
                "Tracewick\\Bridge\\Symfony\\EventSubscriber\\TracewickRequestSubscriber::controllerLabel",
            ]
        },
        "DecrementInteger": {
            "ignore": [
                // See IncrementInteger (exception code / controllerLabel isset indices).
                "Tracewick\\Bridge\\Symfony\\DependencyInjection\\TracewickExtension::load",
                "Tracewick\\Bridge\\Symfony\\EventSubscriber\\TracewickRequestSubscriber::controllerLabel",
            ]
        },
        "FalseValue": {
            "ignoreSourceCodeByRegex": [
                // Equivalent under Symfony's Processor: validate callbacks receive tree-typed values;
                // shape()'s enabled fallback is only for defensive typing of raw arrays.
                "'enabled' => \\\\is_bool\\(\\$v\\['enabled'\\] \\?\\? null\\) \\? \\$v\\['enabled'\\] : false,",
                // See enabled (label_controller fallback in shape()).
                "'label_controller' => \\\\is_bool\\(\\$v\\['label_controller'\\] \\?\\? null\\) \\? \\$v\\['label_controller'\\] : false,",
                // See enabled (profile_console fallback in shape(); default false under Processor).
                "'profile_console' => \\\\is_bool\\(\\$v\\['profile_console'\\] \\?\\? null\\) \\? \\$v\\['profile_console'\\] : false,",
                // See enabled (profile_messenger fallback in shape(); default false under Processor).
                "'profile_messenger' => \\\\is_bool\\(\\$v\\['profile_messenger'\\] \\?\\? null\\) \\? \\$v\\['profile_messenger'\\] : false,",
                // Equivalent in PHPUnit Processor tests: PHP already casts numeric string keys to int
                // before the tree sees them; normalizeKeys matters for YAML/XML loaders, not these tests.
                "->normalizeKeys\\(false\\)",
            ]
        },
        "IfNegation": {
            "ignoreSourceCodeByRegex": [
                // Equivalent under Processor: base_labels is always an array from the tree.
                "if \\(\\\\is_array\\(\\$v\\['base_labels'\\] \\?\\? null\\)\\) \\{",
            ]
        },
        "Foreach_": {
            "ignoreSourceCodeByRegex": [
                // Equivalent under Processor: shape() base_labels copy does not change validation outcomes
                // for configs the tree already accepted as array<string, scalar>.
                "foreach \\(\\$v\\['base_labels'\\] as \\$key => \\$value\\) \\{",
            ]
        },
        "LogicalAnd": {
            "ignoreSourceCodeByRegex": [
                // Equivalent under Processor: non-string keys/values never reach shape() from the tree.
                "if \\(\\\\is_string\\(\\$key\\) && \\\\is_string\\(\\$value\\)\\) \\{",
            ]
        },
        "LogicalAndAllSubExprNegation": {
            "ignoreSourceCodeByRegex": [
                // See LogicalAnd (base_labels string guards in shape()).
                "if \\(\\\\is_string\\(\\$key\\) && \\\\is_string\\(\\$value\\)\\) \\{",
            ]
        },
        "LogicalAndNegation": {
            "ignoreSourceCodeByRegex": [
                // See LogicalAnd (base_labels string guards in shape()).
                "if \\(\\\\is_string\\(\\$key\\) && \\\\is_string\\(\\$value\\)\\) \\{",
            ]
        },
        "LogicalAndSingleSubExprNegation": {
            "ignoreSourceCodeByRegex": [
                // See LogicalAnd (base_labels string guards in shape()).
                "if \\(\\\\is_string\\(\\$key\\) && \\\\is_string\\(\\$value\\)\\) \\{",
            ]
        },
        "LogicalOr": {
            "ignoreSourceCodeByRegex": [
                // Equivalent under Processor: sample_rate is always float|int from floatNode before shape().
                "'sample_rate' => \\\\is_float\\(\\$v\\['sample_rate'\\] \\?\\? null\\) \\|\\| \\\\is_int\\(\\$v\\['sample_rate'\\] \\?\\? null\\)",
            ]
        },

        "LogicalOrAllSubExprNegation": {
            "ignoreSourceCodeByRegex": [
                // See LogicalOr (sample_rate typing in shape()).
                "'sample_rate' => \\\\is_float\\(\\$v\\['sample_rate'\\] \\?\\? null\\) \\|\\| \\\\is_int\\(\\$v\\['sample_rate'\\] \\?\\? null\\)",
            ]
        },
        "LogicalOrNegation": {
            "ignoreSourceCodeByRegex": [
                // See LogicalOr (sample_rate typing in shape()).
                "'sample_rate' => \\\\is_float\\(\\$v\\['sample_rate'\\] \\?\\? null\\) \\|\\| \\\\is_int\\(\\$v\\['sample_rate'\\] \\?\\? null\\)",
            ]
        },
        "LogicalOrSingleSubExprNegation": {
            "ignoreSourceCodeByRegex": [
                // See LogicalOr (sample_rate typing in shape()).
                "'sample_rate' => \\\\is_float\\(\\$v\\['sample_rate'\\] \\?\\? null\\) \\|\\| \\\\is_int\\(\\$v\\['sample_rate'\\] \\?\\? null\\)",
            ]
        },
        "Ternary": {
            "ignoreSourceCodeByRegex": [
                // See LogicalOr (sample_rate typing in shape()).
                "'sample_rate' => \\\\is_float\\(\\$v\\['sample_rate'\\] \\?\\? null\\) \\|\\| \\\\is_int\\(\\$v\\['sample_rate'\\] \\?\\? null\\)",
                // See FalseValue (label_controller fallback in shape()).
                "'label_controller' => \\\\is_bool\\(\\$v\\['label_controller'\\] \\?\\? null\\) \\? \\$v\\['label_controller'\\] : false,",
                // See FalseValue (profile_console fallback in shape()).
                "'profile_console' => \\\\is_bool\\(\\$v\\['profile_console'\\] \\?\\? null\\) \\? \\$v\\['profile_console'\\] : false,",
                // See FalseValue (profile_messenger fallback in shape()).
                "'profile_messenger' => \\\\is_bool\\(\\$v\\['profile_messenger'\\] \\?\\? null\\) \\? \\$v\\['profile_messenger'\\] : false,",
            ]
        },
        "CastFloat": {
            "ignoreSourceCodeByRegex": [
                // Equivalent under Processor: floatNode already yields float before shape().
                "\\? \\(float\\) \\$v\\['sample_rate'\\]",
            ]
        }
    },
    // Match the core Tracewick floor. Raise as the suite matures; never lower.
    "minMsi": 80,
    "minCoveredMsi": 80
}
