{
    "name": "tracewick/symfony-bundle",
    "description": "Official Symfony integration for Tracewick (ext-excimer sampling profiler → spool / Pyroscope)",
    "license": "Apache-2.0",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "profiler",
        "profiling",
        "excimer",
        "pyroscope",
        "continuous-profiling",
        "observability"
    ],
    "authors": [
        {
            "name": "Tracewick contributors",
            "homepage": "https://github.com/tracewick/tracewick/graphs/contributors"
        }
    ],
    "homepage": "https://github.com/tracewick/symfony-bundle",
    "support": {
        "issues": "https://github.com/tracewick/symfony-bundle/issues",
        "source": "https://github.com/tracewick/symfony-bundle",
        "docs": "https://github.com/tracewick/tracewick",
        "security": "https://github.com/tracewick/symfony-bundle/security/policy"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "tracewick/tracewick": "^0.2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.48",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.2",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "ext-excimer": "Required to collect profiles (install with PIE: https://php.github.io/pie/ — pie install wikimedia/excimer)",
        "symfony/messenger": "Required when enabling tracewick.profile_messenger"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tracewick\\Bridge\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tracewick\\Bridge\\Symfony\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/messenger_polyfill.php"
        ],
        "exclude-from-classmap": [
            "tests/Support/MessengerPolyfill/"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "platform-check": false,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.1.x-dev",
            "dev-main": "0.1.x-dev"
        },
        "symfony": {
            "allow-contrib": false
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "@normalize:check",
            "@cs:check",
            "@rector:check",
            "@stan",
            "@deps",
            "@test"
        ],
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "deps": "composer-dependency-analyser",
        "infection": [
            "@test:coverage",
            "@infection:ci"
        ],
        "infection:ci": "infection --coverage=build/coverage --skip-initial-tests --threads=max --show-mutations",
        "normalize:check": "@composer normalize --dry-run --diff --no-check-lock --no-update-lock",
        "rector:check": "rector process --dry-run",
        "rector:fix": "rector process",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover=build/coverage/clover.xml --coverage-xml=build/coverage/coverage-xml --log-junit=build/coverage/junit.xml",
        "test:functional": "phpunit --testsuite functional",
        "test:unit": "phpunit --testsuite unit"
    }
}
